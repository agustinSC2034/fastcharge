---
import { asset } from '../config/site';
---

<section id="app" class="app-section section">
  <div class="wrap app-layout">
    <div class="app-copy">
      <h2>
        Tu próxima carga,
        <br />
        desde tu celular<span class="green-dot">.</span>
      </h2>
      <ol class="steps" role="list">
        {[
          ['Encontrá un cargador', 'Consultá la potencia, el conector y la disponibilidad.'],
          ['Reservá tu turno', 'Elegí cuándo querés cargar.'],
          ['Conectá y seguí la sesión', 'Consultá el progreso y la energía entregada.'],
          ['Recibí el aviso', 'Cuando termine la carga, revisá el detalle en tu historial.'],
        ].map(([title, detail], index) => (
          <li>
            <span class="step-number" aria-hidden="true">
              {index + 1}
            </span>
            <div>
              <h3>{title}</h3>
              <p>{detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="app-notification">
      <img
        src={asset('media/carga-completa-tarjeta.webp')}
        alt="Un conductor mira su celular desde el café de la estación. Su auto está conectado al cargador detrás del ventanal."
        width="1440"
        height="901"
        loading="lazy"
        decoding="async"
      />
      <div class="notification-card">
        <span class="notification-app">
          <span class="status-dot" aria-hidden="true"></span> FastCharge
        </span>
        <strong>Carga completa</strong>
        <span>Tu vehículo llegó al 100 %.</span>
      </div>
    </div>
  </div>
</section>

---
import { asset } from '../config/site';
---

<section class="app-section section" aria-labelledby="charge-break-title">
  <div class="wrap app-layout">
    <div class="app-copy">
      <h2 id="charge-break-title">
        Aprovechá la pausa<span class="green-dot">.</span>
      </h2>
      <p class="lead">
        Mientras tu auto carga, podés tomar un café, comer algo o seguir con tu día. La app te avisa
        cuando termina la carga.
      </p>
    </div>
    <div class="app-notification">
      <img
        src={asset('media/pausa-carga.webp')}
        alt="Un conductor mira su celular desde el café de la estación. Su auto está conectado al cargador detrás del ventanal."
        width="1440"
        height="901"
        loading="lazy"
        decoding="async"
      />
      <div class="notification-card">
        <span class="notification-app">
          <span class="status-dot" aria-hidden="true"></span> FastCharge
        </span>
        <strong>Carga completa</strong>
        <span>Tu vehículo llegó al 100 %.</span>
      </div>
    </div>
  </div>
</section>

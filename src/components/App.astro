---
import { asset } from '../config/site';
---

<section id="app" class="app-section section">
  <div class="wrap app-layout">
    <div class="app-copy">
      <div class="section-label">APP FASTCHARGE</div>
      <h2>
        Tu próxima carga,
        <br />
        desde tu celular<span class="green-dot">.</span>
      </h2>
      <ol class="steps" role="list">
        {[
          ['Encontrá un cargador', 'Consultá la potencia, el conector y la disponibilidad.'],
          ['Reservá tu turno', 'Elegí cuándo querés cargar.'],
          ['Conectá y seguí la sesión', 'Consultá el progreso y la energía entregada.'],
          ['Recibí el aviso', 'Cuando termine la carga, revisá el detalle en tu historial.'],
        ].map(([title, detail], index) => (
          <li>
            <span class="step-number" aria-hidden="true">
              {index + 1}
            </span>
            <div>
              <h3>{title}</h3>
              <p>{detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <figure class="app-notification">
      <img
        src={asset('media/carga-completa-primer-plano.webp')}
        alt="Primer plano del aviso en el celular, con el auto conectado al cargador detrás del ventanal."
        width="1440"
        height="901"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <strong>Carga completa.</strong> Tu vehículo llegó al 100 %.
      </figcaption>
    </figure>
  </div>
</section>

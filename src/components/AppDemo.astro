---
import Logo from './Logo.astro';
import { demoChargers } from '../data/locations';
---

<section id="app" class="app-section section">
  <div class="wrap app-layout">
    <div class="app-copy">
      <div class="section-label">05 / ECOSISTEMA DIGITAL</div>
      <h2>
        Tu próxima carga,
        <br />
        desde tu celular<span class="green-dot">.</span>
      </h2>
      <p class="lead">
        Todo lo que necesitás.
        <br />
        En un mismo lugar.
      </p>
      <p>
        Encontrar una estación, elegir tu cargador y seguir tu sesión. Estamos diseñando una
        experiencia que te acompañe antes, durante y después de cada carga.
      </p>
      <ul class="app-features">
        <li>
          <span>↗</span> Mapa, potencia y disponibilidad
        </li>
        <li>
          <span>↗</span> Reserva de turnos
        </li>
        <li>
          <span>↗</span> Seguimiento e historial de carga
        </li>
      </ul>
      <button class="button dark" id="try-demo">
        Probá la demo <span>↗</span>
      </button>
      <p class="fine-print">
        Prototipo de la futura app. Datos simulados, sin reservas ni transacciones reales.
      </p>
    </div>
    <div class="phone-area">
      <span class="phone-orbit" aria-hidden="true"></span>
      <div class="phone" id="phone">
        <div class="phone-status">
          <span>9:41</span>
          <span class="phone-camera"></span>
          <span>▮▮▮ ▰</span>
        </div>
        <div class="phone-head">
          <Logo />
          <span class="demo-badge">DEMO</span>
        </div>
        <div id="demo-map-state">
          <div class="mini-map" aria-label="Mapa esquemático de demostración">
            <svg viewBox="0 0 320 210" aria-hidden="true">
              <rect width="320" height="210" fill="#e7ecdf" />
              <path
                d="M0 50h320M0 110h320M0 170h320M60 0v210M145 0v210M240 0v210"
                stroke="#fff"
                stroke-width="12"
              />
              <path d="M-10 200L280 -20" stroke="#c2cfb4" stroke-width="32" />
              <path d="M-10 200L280 -20" stroke="#fff" stroke-width="6" />
              <path d="M240 30h65v60h-65zM70 120h55v40H70z" fill="#cbdcb6" />
              <circle cx="166" cy="108" r="35" fill="#c0ec76" fill-opacity=".25" />
            </svg>
            <span class="demo-pin">F</span>
            <span class="map-demo-label">Mapa ilustrativo</span>
          </div>
          <div class="phone-body">
            <p class="phone-eyebrow">TU PRÓXIMA PARADA</p>
            <h3>Estación de demostración</h3>
            <p class="phone-sub">Elegí un cargador para explorar</p>
            {demoChargers.map((c, i) => (
              <button
                class:list={['demo-charger', { selected: i === 0 }]}
                data-demo-charger={i}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span>
                  <b>Cargador {String(i + 1).padStart(2, '0')}</b>
                  <small>
                    {c.power} kW · {c.connector}
                  </small>
                </span>
                <span class={c.available ? 'available' : 'busy'}>
                  {c.available ? 'Disponible' : 'Ocupado'}
                </span>
              </button>
            ))}
            <button id="demo-reserve" class="button full">
              Reservar en demo <span>→</span>
            </button>
            <p id="demo-selection-status" class="phone-note" aria-live="polite">
              Disponibilidad simulada
            </p>
          </div>
        </div>
        <div id="demo-reserve-state" class="phone-body" hidden>
          <button class="phone-back" data-demo-back>
            ← Volver al mapa
          </button>
          <p class="phone-eyebrow">RESERVA DE DEMOSTRACIÓN</p>
          <h3>Una pausa a tu medida.</h3>
          <p class="phone-sub">
            Cargador 01 · {demoChargers[0].power} kW · {demoChargers[0].connector}
          </p>
          <label class="demo-field">
            Duración del turno
            <select id="demo-duration">
              <option value="20">20 minutos</option>
              <option value="30">30 minutos</option>
              <option value="45">45 minutos</option>
            </select>
          </label>
          <div class="demo-summary">
            <span>Tu selección</span>
            <strong id="duration-summary">20 minutos</strong>
            <small>Turno simulado · Sin costo ni reserva efectiva</small>
          </div>
          <button class="button full" id="demo-confirm">
            Simular reserva →
          </button>
        </div>
        <div id="demo-session-state" class="phone-body" hidden>
          <p class="phone-eyebrow">SESIÓN SIMULADA</p>
          <h3>Tu energía, en marcha.</h3>
          <div class="charge-ring">
            <div>
              <strong>
                68<span>%</span>
              </strong>
              <small>Batería simulada</small>
            </div>
          </div>
          <div class="session-stats">
            <div>
              <strong>
                18,4 <small>kWh</small>
              </strong>
              <span>Energía entregada</span>
            </div>
            <div>
              <strong id="session-duration">
                20 <small>min</small>
              </strong>
              <span>Turno elegido</span>
            </div>
          </div>
          <p class="phone-note">Demostración completada. No se creó una reserva real.</p>
          <button class="button full" id="demo-history">
            Ver historial demo →
          </button>
        </div>
        <div id="demo-history-state" class="phone-body" hidden>
          <p class="phone-eyebrow">HISTORIAL DE DEMOSTRACIÓN</p>
          <h3>Cada parada cuenta.</h3>
          <div class="history-entry">
            <span>Sesión de ejemplo</span>
            <strong>18,4 kWh</strong>
            <small>CCS2 · Cargador 01 · Datos simulados</small>
          </div>
          <button class="button full" data-demo-back>
            Volver a explorar ↗
          </button>
        </div>
        <div class="phone-footer">
          <button data-demo-back aria-label="Ver mapa de demostración">
            ⌖<span>Mapa</span>
          </button>
          <button id="nav-history" aria-label="Ver historial de demostración">
            ◷<span>Historial</span>
          </button>
          <span class="phone-footer-label">FastCharge demo</span>
        </div>
        <div class="home-indicator"></div>
      </div>
      <div class="floating-label">
        <span class="status-dot"></span> Una experiencia conectada.
      </div>
    </div>
  </div>
</section>

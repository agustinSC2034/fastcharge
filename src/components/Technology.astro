---
import { asset } from '../config/site';
---

<section class="section wrap technology">
  <div class="technology-layout">
    <img
      class="section-photo"
      src={asset('media/tecnologia.webp')}
      alt="Detalle de la pantalla y el indicador de estado de un cargador eléctrico"
      width="1200"
      height="800"
      loading="lazy"
      decoding="async"
    />
    <div>
      <div class="section-label">TECNOLOGÍA</div>
      <h2>
        Gestión de la red de carga<span class="green-dot">.</span>
      </h2>
      <p class="lead">
        Una plataforma central para consultar el estado de los equipos, monitorear sesiones y
        administrar los puntos de carga.
      </p>
    </div>
  </div>
</section>

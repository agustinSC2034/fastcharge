---
import { asset } from '../config/site';
---

<section class="section wrap technology">
  <div class="technology-layout">
    <img
      class="section-photo"
      src={asset('media/tecnologia.webp')}
      alt="Detalle de la pantalla y el indicador de estado de un cargador eléctrico"
      width="1200"
      height="800"
      loading="lazy"
      decoding="async"
    />
    <div>
      <div class="section-label">TECNOLOGÍA</div>
      <h2>
        Cargadores conectados<span class="green-dot">.</span>
      </h2>
      <p class="lead">
        Cada equipo informa su estado a una plataforma central. Así se puede saber qué cargadores
        están disponibles, cuáles están en uso y cuáles requieren atención.
      </p>
      <ul class="technology-status" aria-label="Estados del cargador">
        <li>Disponible</li>
        <li>En uso</li>
        <li>Requiere atención</li>
      </ul>
    </div>
  </div>
</section>

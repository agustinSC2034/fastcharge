---
import { categories } from '../data/locations';
---

<section id="ubicaciones" class="network section">
  <div class="wrap network-layout">
    <div class="network-copy">
      <div class="section-label">UBICACIONES</div>
      <h2>
        Próximamente
        <br />
        en Buenos Aires<span class="green-dot">.</span>
      </h2>
      <p class="lead">Conocé dónde estamos planificando las primeras estaciones.</p>
      <div class="network-filters" aria-label="Tipo de ubicación">
        {categories.map((c, i) => (
          <button aria-pressed={i === 0 ? 'true' : 'false'} data-category={c.id}>
            {c.label}
          </button>
        ))}
      </div>
      <p id="network-description" aria-live="polite">
        {categories[0].copy}
      </p>
      <p class="network-status" id="network-status">
        Las ubicaciones se publicarán a medida que se confirmen.
      </p>
    </div>
    <div class="map-frame">
      <div id="network-map" role="region" aria-label="Mapa de Buenos Aires">
        <p class="map-loading">Buenos Aires</p>
      </div>
      <div class="map-caption">
        <span class="status-dot"></span> Próximamente
      </div>
    </div>
  </div>
</section>

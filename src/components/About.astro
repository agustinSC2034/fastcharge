---
import { asset } from '../config/site';
---

<section id="fastcharge" class="section wrap about">
  <div class="section-label">01 / SOMOS FASTCHARGE</div>
  <div class="editorial">
    <h2 class="reveal">
      Una nueva
      <br />
      forma de cargar<span class="green-dot">.</span>
    </h2>
    <div class="editorial-copy reveal">
      <p class="lead">
        Tu vida sigue.
        <br />
        Tu auto se carga.
      </p>
      <p>
        Desarrollamos una red de carga para vehículos eléctricos que se integra a tus recorridos.
      </p>
      <a class="line-link" href="#soluciones">
        Conocé nuestras soluciones <span>↗</span>
      </a>
    </div>
  </div>
  <figure class="wide-photo reveal">
    <img
      src={asset('media/charging-1600.webp')}
      srcset={`${asset('media/charging-800.webp')} 800w, ${asset('media/charging-1600.webp')} 1600w`}
      sizes="(max-width: 800px) 100vw, 90vw"
      alt="Detalle conceptual de un auto eléctrico conectado a un cargador de corriente continua"
      width="1600"
      height="900"
      loading="lazy"
    />
    <figcaption>Conectar. Cargar. Seguir.</figcaption>
  </figure>
  <div class="difference-title">
    <h3>
      Menos tiempo cargando.
      <br />
      <span>Más tiempo en movimiento.</span>
    </h3>
  </div>
  <div class="pillars">
    {[
      [
        '01',
        'Potencia.',
        'Soluciones de carga rápida para acompañar tus viajes y actividades diarias.',
      ],
      ['02', 'Ubicación.', 'Estaciones pensadas para lugares de circulación y paradas habituales.'],
      [
        '03',
        'Experiencia.',
        'Tecnología para encontrar, gestionar y utilizar cargadores con facilidad.',
      ],
    ].map(([n, title, copy]) => (
      <article class="reveal">
        <span class="pillar-number">{n} /</span>
        <h3>{title}</h3>
        <p>{copy}</p>
      </article>
    ))}
  </div>
</section>

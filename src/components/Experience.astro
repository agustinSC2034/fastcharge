---
import { asset } from '../config/site';

const steps = [
  ['Encontrá una estación', 'Buscá un punto de carga en tu recorrido.'],
  ['Elegí el cargador', 'Consultá la potencia, el conector y la disponibilidad.'],
  ['Reservá tu turno', 'Elegí cuándo querés cargar.'],
  ['Conectá y cargá', 'Seguí la carga y consultá la energía entregada.'],
];
---

<section class="section wrap experience">
  <div class="experience-layout">
    <div>
      <h2>
        Cargá en cuatro pasos<span class="green-dot">.</span>
      </h2>
      <ol class="steps">
        {steps.map(([title, copy], index) => (
          <li>
            <span class="step-number" aria-hidden="true">
              {index + 1}
            </span>
            <div>
              <h3>{title}</h3>
              <p>{copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <img
      class="section-photo"
      src={asset('media/conectar.webp')}
      alt="Una persona conecta el cable de carga a su vehículo eléctrico"
      width="960"
      height="1200"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
